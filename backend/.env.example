# Copiá a .env para desarrollo local (o exportá en tu shell).
PORT=8080
DATABASE_URL=postgres://ticopay:ticopay_dev@localhost:5433/ticopay?sslmode=disable
JWT_SECRET=dev-secret-change-in-production-please-32+
CORS_ORIGINS=http://localhost:5174
RUN_MIGRATIONS=true
SEED_DEMO=true
