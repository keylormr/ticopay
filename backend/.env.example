# Copiá a .env para desarrollo local (o exportá en tu shell).
PORT=8080
# development | production. En production el server EXIGE un JWT_SECRET fuerte y
# NO siembra datos demo (sin cuenta admin de contraseña pública).
APP_ENV=development
DATABASE_URL=postgres://tuanispay:tuanispay_dev@localhost:5433/tuanispay?sslmode=disable
# Obligatorio en producción: mínimo 32 bytes aleatorios. Generá uno con:
#   openssl rand -base64 48
# En local podés dejarlo vacío (usa un default solo-dev y el server avisa).
JWT_SECRET=
CORS_ORIGINS=http://localhost:5174
RUN_MIGRATIONS=true
SEED_DEMO=true
# Producción: correo de la cuenta que se promueve a administrador al arrancar
# (aprueba comercios y ajusta comisiones). Dejar vacío en local; el seed demo
# ya hace admin a maria@tuanispay.cr.
ADMIN_EMAIL=
# Opcional: token bearer que protege GET /metrics (formato Prometheus).
# Vacío deshabilita el endpoint (responde 404). En producción, poné uno fuerte.
METRICS_TOKEN=
